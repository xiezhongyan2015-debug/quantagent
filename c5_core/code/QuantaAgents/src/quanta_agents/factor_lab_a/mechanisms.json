{
  "version": "2026-09-13",
  "note": "A股日频价量异象与机制目录。status 由程序根据候选结果计算：unexplored / tried / weak / pass。literature 只是量级提示，不是本项目证据。",
  "data_sources": ["price", "volume", "amount", "turnover", "cap", "vwap", "market"],
  "transformations": ["level", "change", "ratio", "residual", "rank", "zscore", "condition", "interaction", "neutralized"],
  "mechanisms": [
    {"id": "short_reversal", "family": "reversal", "name": "短期反转", "mechanism": "过去5-20日涨幅高的股票随后回落；流动性提供与过度反应。", "canonical": "-(close / lag(close, 20) - 1)", "horizon": "5-20d", "literature": "全A RankIC约0.05-0.08，沪深300弱得多", "fields": ["close"]},
    {"id": "medium_momentum", "family": "momentum", "name": "中期动量", "mechanism": "3-12个月收益延续，A股整体偏弱且不稳定，常需剔除最近1个月。", "canonical": "lag(close, 20) / lag(close, 120) - 1", "horizon": "20-60d", "literature": "A股接近零或为负", "fields": ["close"]},
    {"id": "low_volatility", "family": "volatility", "name": "低波动", "mechanism": "高波动股票被博彩偏好高估；低波动股票风险调整后收益高。", "canonical": "-rolling_std(ret, 20)", "horizon": "5-20d", "literature": "全A RankIC约0.06-0.08", "fields": ["ret"]},
    {"id": "idiosyncratic_vol", "family": "volatility", "name": "特质波动", "mechanism": "相对市场残差的波动率，剔除系统性部分后的博彩偏好。", "canonical": "-rolling_std(rolling_residual(ret, mkt_ret, 60), 20)", "horizon": "5-20d", "literature": "与低波动高度相关", "fields": ["ret", "mkt_ret"]},
    {"id": "lottery_maxret", "family": "volatility", "name": "彩票效应/最大单日收益", "mechanism": "近期出现过大涨的股票被追捧后回落。", "canonical": "-rolling_max(ret, 20)", "horizon": "5-20d", "literature": "全A RankIC约0.06-0.08", "fields": ["ret"]},
    {"id": "return_skewness", "family": "volatility", "name": "收益偏度", "mechanism": "正偏收益的股票被高估。", "canonical": "-rolling_skew(ret, 20)", "horizon": "5-20d", "literature": "弱到中等", "fields": ["ret"]},
    {"id": "turnover_liquidity", "family": "liquidity", "name": "换手率", "mechanism": "高换手代表投机热度与流动性溢价低；A股最稳的价量异象之一。", "canonical": "-rolling_mean(turnover, 20)", "horizon": "5-20d", "literature": "全A RankIC约0.06-0.08", "fields": ["turnover"]},
    {"id": "abnormal_turnover", "family": "liquidity", "name": "异常换手", "mechanism": "短期换手相对长期基准的放大，反映关注度冲击。", "canonical": "-(rolling_mean(turnover, 5) / rolling_mean(turnover, 60))", "horizon": "5-10d", "literature": "中等", "fields": ["turnover"]},
    {"id": "turnover_volatility", "family": "liquidity", "name": "换手率波动", "mechanism": "换手率不稳定的股票投机性强。", "canonical": "-rolling_std(turnover, 20) / rolling_mean(turnover, 20)", "horizon": "5-20d", "literature": "中等", "fields": ["turnover"]},
    {"id": "illiquidity", "family": "liquidity", "name": "非流动性(Amihud)", "mechanism": "单位成交额引起的价格冲击大，要求流动性溢价。", "canonical": "rolling_mean(abs(ret) / amount, 20)", "horizon": "5-20d", "literature": "与市值高度相关", "fields": ["ret", "amount"]},
    {"id": "size", "family": "size", "name": "市值", "mechanism": "小市值溢价；2017-2018、2021以后逐段翻转，需条件化。", "canonical": "-log_cap", "horizon": "20d+", "literature": "不稳定", "fields": ["log_cap"]},
    {"id": "intraday_overnight", "family": "intraday", "name": "日内-隔夜收益差", "mechanism": "隔夜收益为正、日内为负的股票反映机构与散户力量差异。", "canonical": "-rolling_mean(log(close / open) - log(open / prev_close), 20)", "horizon": "5-20d", "literature": "中等", "fields": ["close", "open", "prev_close"]},
    {"id": "close_location", "family": "price_shape", "name": "收盘位置", "mechanism": "收盘接近日内高点表示买盘强。", "canonical": "rolling_mean(where(high > low, (2 * close - high - low) / (high - low), 0), 20)", "horizon": "5-10d", "literature": "弱", "fields": ["high", "low", "close"]},
    {"id": "52w_high", "family": "momentum", "name": "52周高点", "mechanism": "接近历史高点的锚定效应。", "canonical": "close / rolling_max(high, 250)", "horizon": "20d+", "literature": "A股弱", "fields": ["close", "high"]},
    {"id": "vwap_deviation", "family": "price_shape", "name": "收盘相对均价偏离", "mechanism": "收盘远高于当日均价代表尾盘拉升，次日回落。", "canonical": "-(close / vwap - 1)", "horizon": "1-5d", "literature": "短期有效", "fields": ["close", "vwap"]},
    {"id": "price_volume_corr", "family": "volume", "name": "量价相关", "mechanism": "涨时放量跌时缩量的股票反映追涨情绪，随后回落。", "canonical": "-rolling_corr(ret, log(volume), 20)", "horizon": "5-20d", "literature": "中等", "fields": ["ret", "volume"]},
    {"id": "volume_trend", "family": "volume", "name": "成交量趋势", "mechanism": "成交量持续上升代表关注度提高。", "canonical": "-(rolling_mean(volume, 5) / rolling_mean(volume, 60))", "horizon": "5-20d", "literature": "与异常换手重叠", "fields": ["volume"]},
    {"id": "amount_per_trade_proxy", "family": "volume", "name": "单笔金额代理", "mechanism": "成交额/成交量=均价，无法直接得到单笔；需分钟或L2数据。", "canonical": null, "horizon": "5d", "literature": "需要新数据", "fields": ["minute"]},
    {"id": "range_compression", "family": "condition", "name": "波幅压缩后突破", "mechanism": "波幅收窄后的突破方向延续。", "canonical": "(rolling_mean(log(high / low), 5) < rolling_mean(log(high / low), 60)) * sign(close - rolling_max(high, 20))", "horizon": "5-10d", "literature": "弱", "fields": ["high", "low", "close"]},
    {"id": "downside_share", "family": "risk", "name": "下行波动占比", "mechanism": "下行方差占总方差比例高的股票风险溢价高。", "canonical": "rolling_sum(where(ret < 0, ret * ret, 0), 20) / rolling_sum(ret * ret, 20)", "horizon": "5-20d", "literature": "弱到中等", "fields": ["ret"]},
    {"id": "overnight_gap_risk", "family": "risk", "name": "隔夜跳空风险", "mechanism": "隔夜跳空绝对值大的股票信息不确定性高。", "canonical": "-rolling_sum(abs(log(open / prev_close)), 20)", "horizon": "5-20d", "literature": "与波动重叠", "fields": ["open", "prev_close"]},
    {"id": "market_beta", "family": "risk", "name": "市场贝塔", "mechanism": "低贝塔异象。", "canonical": "-rolling_beta(ret, mkt_ret, 60)", "horizon": "20d+", "literature": "A股弱", "fields": ["ret", "mkt_ret"]},
    {"id": "size_conditioned_reversal", "family": "interaction", "name": "市值条件反转", "mechanism": "小市值中反转更强。", "canonical": "-(close / lag(close, 20) - 1) * (1 - cs_rank(log_cap))", "horizon": "5-20d", "literature": "待验证", "fields": ["close", "log_cap"]},
    {"id": "turnover_conditioned_reversal", "family": "interaction", "name": "换手条件反转", "mechanism": "高换手伴随的上涨更容易反转。", "canonical": "-(close / lag(close, 20) - 1) * cs_rank(rolling_mean(turnover, 20))", "horizon": "5-20d", "literature": "待验证", "fields": ["close", "turnover"]},
    {"id": "volatility_conditioned_momentum", "family": "interaction", "name": "波动条件动量", "mechanism": "低波动中的动量更可靠。", "canonical": "(lag(close, 20) / lag(close, 120) - 1) * (1 - cs_rank(rolling_std(ret, 60)))", "horizon": "20d+", "literature": "待验证", "fields": ["close", "ret"]},
    {"id": "size_neutral_turnover", "family": "neutralized", "name": "市值中性换手", "mechanism": "去掉市值后的换手信息。", "canonical": "-cs_neutralize(cs_rank(rolling_mean(turnover, 20)), log_cap)", "horizon": "5-20d", "literature": "待验证", "fields": ["turnover", "log_cap"]},
    {"id": "path_efficiency", "family": "price_shape", "name": "路径效率", "mechanism": "净涨幅与路径总长之比高的趋势更平稳。", "canonical": "abs(close / lag(close, 20) - 1) / rolling_sum(abs(ret), 20) * sign(close / lag(close, 20) - 1)", "horizon": "5-20d", "literature": "弱", "fields": ["close", "ret"]},
    {"id": "volume_price_divergence", "family": "volume", "name": "量价背离", "mechanism": "价格新高但成交量未放大，趋势可疑。", "canonical": "ts_rank(close, 20) - ts_rank(volume, 20)", "horizon": "5-20d", "literature": "待验证", "fields": ["close", "volume"]},
    {"id": "consecutive_moves", "family": "price_shape", "name": "连续涨跌天数", "mechanism": "连续多日同向后反转。", "canonical": "-rolling_sum(sign(ret), 5)", "horizon": "1-5d", "literature": "短期", "fields": ["ret"]},
    {"id": "rank_persistence", "family": "condition", "name": "截面排名持续性", "mechanism": "因子截面排名的时序稳定性作为条件。", "canonical": null, "horizon": "n/a", "literature": "程序级条件", "fields": []}
  ]
}
